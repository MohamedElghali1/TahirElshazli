# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Testing
coverage/
.nyc_output/

# Misc
.cache/
tmp/

# Docker
.docker/

# Ruflo local secrets and runtime data
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
.claude-flow/metrics/
.claude-flow/security/audit-status.json
# Runtime state of the local ruflo daemon - per-machine, never shared.
.claude-flow/daemon.pid
.claude-flow/daemon-state.json
.swarm/memory.db
# Locally-adopted harness tuning, stamped with this machine's epoch timestamps
# and champion hashes. Same category as the daemon state above: it churns on
# every machine that runs the harness and means nothing on another one. The
# agent definitions under .claude/agents/ are the opposite - those are project
# assets and stay tracked.
.claude-flow/harness-active-policy.json
.claude-flow/policy/
.claude/proven-config.json
.claude/.proven-config-version
# Local swarm runtime: the vector index the memory store rebuilds on demand,
# and per-run swarm state. Same category as the daemon state above - churns on
# every machine, means nothing on another one.
.swarm/hnsw.index
.swarm/hnsw.metadata.json
.claude-flow/swarm/

# Locally-uploaded files (STORAGE_DRIVER=local, CLAUDE.md §5.19). Development
# only - it is refused in production - and the contents are whatever the
# developer dragged into the blog authoring form, so they belong to the machine
# and never to the repository. UPLOAD_DIR can point anywhere; this covers the
# default.
backend/var/
