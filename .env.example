# Proposed replacement for .env.example (REM-012). .env.example itself is
# permission-blocked in this session; the lead copies this file over it.
#
# Derived from backend/src/common/config/env.ts (every resolve* function),
# backend/src/database/database.module.ts (DATABASE_POOL_MAX, PGSSLMODE),
# backend/src/database/cli/bootstrap-staff.ts (BOOTSTRAP_*), frontend/lib/api.ts
# (NEXT_PUBLIC_API_URL, INTERNAL_API_URL), and a grep for every other
# `process.env.*` / `env.*` read in backend/src. One short comment per
# variable: the default, and what production refuses.
#
# No Bunny, NEXT_PUBLIC_VIDEO_CDN, CLOUDFLARE_R2_*, Resend, Paymob or
# Stripe — nothing in this codebase reads them.

# --- Core ---------------------------------------------------------------

# development | test | production. Unset defaults to development. Any other
# value is refused at boot (a typo must not silently fall back to dev).
NODE_ENV=development

# The HTTP port the NestJS API binds to. Defaults to 3001 (3000 is the
# Next.js frontend). Must be an integer 1-65535.
PORT=3001

# HMAC-SHA256 signing key for access tokens. Unset in development falls back
# to a published placeholder (dev-secret-change-in-production). In
# production, unset / a known placeholder / shorter than 32 chars all refuse
# to boot. Generate with: openssl rand -base64 48
JWT_SECRET=dev-secret-change-in-production

# A duration like 30m, 24h or 7d. Defaults to 1h. Also the window before a
# logout propagates to a token already issued (the denylist is per-process).
JWT_EXPIRY=1h

# How many reverse proxies sit in front of the app, for reading the real
# client IP out of X-Forwarded-For. 0 (default) trusts nothing — correct for
# local development. Behind Cloudflare + the VPS nginx, this must be 2, and
# only once the Cloudflare-only firewall (deploy/cloudflare-firewall.sh) is
# in place — otherwise a client can forge X-Forwarded-For and dodge the
# rate limiter.
TRUSTED_PROXY_HOPS=0

# --- Database -------------------------------------------------------------

# memory | postgres. Unset resolves to postgres in production, memory
# otherwise. memory is refused outright in production (every write would be
# lost on restart, invisible to any other replica).
PERSISTENCE_DRIVER=memory

# postgresql://user:password@host:5432/tahirelshazli — required whenever
# PERSISTENCE_DRIVER=postgres; the memory driver never reads it.
DATABASE_URL=postgresql://lms:changeme@localhost:5432/tahirelshazli

# Postgres connection pool ceiling. Defaults to 10, which is fine for one
# replica at this scale (~300 students).
DATABASE_POOL_MAX=10

# Unset by default (no TLS in local development). Set to no-verify only for
# a managed Postgres whose certificate chain the container does not carry —
# never for a connection that is not already encrypted some other way.
# PGSSLMODE=no-verify

# 0 | 1 | true | false. Defaults to 0 (off). Off by design: with more than
# one replica, auto-migrating on boot races every instance against the same
# DDL. A migration is a deliberate CI/CD step, not a side effect of starting
# the container.
DB_AUTO_MIGRATE=0

# 0 | 1 | true | false. Defaults to 0 (off). Development-only convenience —
# refused outright in production, because the fixtures insert accounts with
# a published password hash, so seeding a real database hands out logins.
DB_AUTO_SEED=0

# --- CORS / links -----------------------------------------------------

# Comma-separated list of allowed browser origins. Unset reflects every
# Origin header back (fine for local development); unset in production is
# refused outright, since with credentials enabled that would be an open
# door.
CORS_ORIGIN=http://localhost:3000

# The base URL mail templates build links against (sign-in links, password
# resets). Defaults to http://localhost:3000; unset in production is
# refused, rather than silently mailing out a broken localhost link.
FRONTEND_URL=http://localhost:3000

# --- File storage -----------------------------------------------------

# none | local | r2. Unset resolves to local in development, none in
# production. local is refused in production outright (uploaded files would
# be lost on the next deploy while the database rows pointing at them
# survive). r2 is the production-legal value once the client's Cloudflare R2
# account exists.
STORAGE_DRIVER=local

# Where the local driver writes, relative to the process working directory.
# Defaults to var/uploads. Unused by none or r2.
UPLOAD_DIR=var/uploads

# The following four are required together, only when STORAGE_DRIVER=r2; a
# driver half-configured at boot is refused rather than failing on the first
# upload. Create an R2 API token with object read/write on the bucket at
# https://dash.cloudflare.com.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Mail -----------------------------------------------------------------

# none | log | smtp. Unset resolves to log in development, none in
# production. none answers every mail-dependent route (announcements,
# student creation, invitations, password reset) with a 503 — not refused at
# boot, since a working mail provider is the client's subscription to
# provision, but required in practice for those routes to work at all.
MAIL_DRIVER=log

# All five required together, only when MAIL_DRIVER=smtp.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_SMTP_FROM=

# --- Google (Forms sync + sign-in) -----------------------------------

# none | google. Defaults to none everywhere, including production — a
# Google Cloud project and OAuth client are a human-provisioned step; nothing
# about this application should fail to boot before they exist. With none,
# the integration endpoints answer 503 "not configured".
GOOGLE_DRIVER=none

# Required together, only when GOOGLE_DRIVER=google. The redirect URI must
# match an Authorized redirect URI on the OAuth client byte for byte.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.tahirelshazli.com/admin/integrations/google/callback

# 32 bytes of base64, required in EVERY environment once GOOGLE_DRIVER=google
# (not production-only like JWT_SECRET) — it encrypts a long-lived Google
# refresh token at rest, a real third-party credential the moment anyone
# clicks Connect. Generate with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# A second Authorized redirect URI on the same OAuth client, on the WEB app
# (not the API) — what comes back has to become a browser session. Unset
# means Google sign-in is off and staff keep their passwords. https required
# in production.
GOOGLE_SIGN_IN_REDIRECT_URI=

# Comma-separated bare domains (e.g. tahirelshazli.com) a staff Google
# sign-in's verified `hd` claim must match. Empty (default) means staff
# Google sign-in is off. Students are never pinned to a domain.
STAFF_GOOGLE_DOMAINS=

# --- Postgres container (docker-compose.prod.yml only) -------------------

POSTGRES_USER=lms
POSTGRES_PASSWORD=changeme

# --- Frontend ---------------------------------------------------------

# Where the BROWSER reaches the API. Inlined into the client bundle at BUILD
# time (next.config.ts, Dockerfile.frontend ARG) — changing it needs a
# rebuild, not a restart. Falls back to http://localhost:3001 if unset.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Where the WEB CONTAINER reaches the API when rendering on the server — a
# different network than the browser's. In Docker Compose this is the
# service name (http://api:3001); unset falls back to NEXT_PUBLIC_API_URL,
# which is correct only when both are the same origin (e.g. `npm run dev`).
INTERNAL_API_URL=
