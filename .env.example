# Tahirelshazli LMS - Environment Configuration Template
# Copy this to .env and fill in actual values

# DATABASE
# Which repository implementations the app wires up: `memory` keeps the
# InMemory*Repository stubs (no database needed, data lost on restart, nothing
# shared between replicas), `postgres` uses the real ones. Unset means `memory`
# in development and test, and `postgres` in production - where `memory` is
# refused outright.
PERSISTENCE_DRIVER=memory
# Only required when PERSISTENCE_DRIVER=postgres. A production boot without it
# fails at startup rather than on the first query.
DATABASE_URL=postgresql://dev:devpassword@localhost:5432/tahirelshazli
# Run pending migrations at boot. Safe for a single container; with more than
# one replica every instance races to apply the same DDL, so use the explicit
# `npm run db:migrate` step in CI/CD instead.
DB_AUTO_MIGRATE=0

# JWT
# REQUIRED in production - the app refuses to boot without it, and refuses to
# boot if it still holds the development placeholder. Generate with:
#   openssl rand -base64 48
JWT_SECRET=your-secret-key-change-in-production
# The token denylist is per-process, so a logout on one replica is invisible to
# the others until the token expires on its own. This value is that window.
JWT_EXPIRY=1h

# CORS - comma-separated allowed origins. REQUIRED in production; without it the
# API would reflect any Origin back with credentials enabled.
CORS_ORIGIN=http://localhost:3000

# Reverse-proxy hops in front of the app (Cloudflare + VPS proxy = 2). Wrong
# values break per-IP rate limiting: too low buckets everyone together, too high
# lets a client spoof its address via X-Forwarded-For.
TRUSTED_PROXY_HOPS=1

# Cloudflare R2 (File Storage)
CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY=your-access-key
CLOUDFLARE_R2_SECRET_KEY=your-secret-key
CLOUDFLARE_R2_BUCKET=tahirelshazli

# Bunny Stream (Video Hosting)
BUNNY_STREAM_API_KEY=your-api-key
BUNNY_STREAM_LIBRARY_ID=your-library-id

# Email Service (Resend/SendGrid)
EMAIL_SERVICE=resend
RESEND_API_KEY=your-resend-api-key

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_VIDEO_CDN=https://bunny-stream-cdn.example.com
NEXT_PUBLIC_STORAGE_URL=https://r2-cdn.example.com

# Google Forms integration
# Unset (or `none`) disables it cleanly: the endpoints answer 503 and form-based
# work still functions as a plain link, so nothing breaks - you get completion
# tracking instead of scores. `google` turns it on and makes the four values
# below REQUIRED; a half-configured integration refuses to boot rather than
# failing later. Full walkthrough: docs/google-forms-setup.md
GOOGLE_DRIVER=none
# From the OAuth 2.0 Web application client at
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-oauth-client-id
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
# Must match an Authorized redirect URI on that client BYTE FOR BYTE - Google
# compares them as strings, so a trailing slash or http-vs-https difference
# fails with `redirect_uri_mismatch` and no further explanation.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/admin/integrations/google/callback
# Encrypts the stored Google refresh token at rest (CLAUDE.md §8). Required in
# EVERY environment when GOOGLE_DRIVER=google, unlike JWT_SECRET - the token it
# protects is a real credential for a real Google account the moment anyone
# clicks Connect, not a fixture. Rotating it invalidates the stored credential;
# the fix is to reconnect. Generate with:
#   openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Google sign-in (`GAUTH-1`)
# Reuses the OAuth client above, so it is rejected at boot unless
# GOOGLE_DRIVER=google. Leaving it unset is how you turn sign-in off: the routes
# answer 503 and password sign-in is untouched, so a server set up only for
# Forms never offers a Google button pointing at a redirect nobody registered.
# Absolute URL, and https in production - the authorization code travels to it.
# It points at the WEB APP, not the API, because what comes back has to become a
# session in the browser. Register it as a SECOND Authorized redirect URI on the
# same OAuth client; Google matches it byte for byte, like the one above.
# Locally that is http://localhost:3000/google/callback - left empty here because
# setting it while GOOGLE_DRIVER=none above refuses the boot outright.
GOOGLE_SIGN_IN_REDIRECT_URI=
# `D-51`: the Workspace domains a staff account may use Google from, checked
# against the verified id_token's `hd` claim. EMPTY MEANS STAFF GOOGLE SIGN-IN IS
# OFF - staff keep their passwords, and only students can link. Comma-separated
# bare domain names (e.g. tahirelshazli.com); a malformed entry stops the boot,
# because the alternative is a typo locking every staff member out in silence.
STAFF_GOOGLE_DOMAINS=

# Payment Gateways (Future)
PAYMOB_API_KEY=your-paymob-key
STRIPE_SECRET_KEY=your-stripe-key

# Environment
NODE_ENV=development
# Port the API binds to. Defaults to 3001 (see resolvePort in
# backend/src/common/config/env.ts) because 3000 is the Next.js frontend and
# `npm run dev` starts both. Set here explicitly so the value the API binds and
# the port docker-compose forwards can never drift apart silently.
PORT=3001

# Set to 1 to print password-reset tokens to the server log. Local development
# only - a reset token is a live account-takeover credential. Leave unset
# everywhere else; the notifier logs nothing without it.
LOG_RESET_TOKENS=0
