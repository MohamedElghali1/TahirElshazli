# syntax=docker/dockerfile:1
#
# NestJS API image.
#
# The build context is the REPO ROOT, not backend/. This is an npm workspaces
# monorepo with a single lockfile at the root: there is no
# backend/package-lock.json, so an `npm ci` run from inside backend/ fails
# outright. Build it with `docker build -f Dockerfile.backend .` from the root.

FROM node:20-alpine AS builder

WORKDIR /app

# Manifests before sources, so editing a .ts file reuses the cached install
# layer. Every workspace manifest has to be present: npm reads the `workspaces`
# array from the root package.json and errors on a directory that has no
# package.json, even when only the other workspace is being installed.
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/

# Dev dependencies included - `nest build` is one of them.
RUN npm ci

COPY backend/ ./backend/

# nest-cli.json declares database/migrations/**/*.sql and database/seeds/**/*.sql
# as build assets, so they land in dist/. MigrationRunner reads them from dist at
# runtime: if that asset config is ever dropped, this image builds fine and then
# fails on the first migrate.
RUN npm run build --workspace=backend


FROM node:20-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production

# Production dependencies only, resolved through the same workspace layout the
# build used, so the hoisted node_modules at /app/node_modules stays on the
# resolution path for /app/backend/dist.
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/
RUN npm ci --omit=dev --workspace=backend \
 && npm cache clean --force

COPY --from=builder /app/backend/dist ./backend/dist

# The local upload driver's write target, created here rather than at runtime.
# Everything copied above is owned by root, and the process runs as `node`
# below, so `LocalDiskStorage.mkdir` would fail with EACCES on the first upload
# - a 500 on a working feature, from a permission bit. Pre-creating it owned by
# `node` also decides the ownership of a Docker named volume mounted here:
# Compose seeds an empty volume from the image path, ownership included, so an
# empty root-owned volume is what you get if this line is removed.
#
# Note this directory stays unused in a real production deploy, where
# STORAGE_DRIVER defaults to `none` and `local` is refused outright
# (env.ts resolveStorageDriver). It exists for the containerized *development*
# stack in docker-compose.yml, and as the mount point R2 replaces rather than
# fills.
RUN mkdir -p /app/backend/var/uploads \
 && chown -R node:node /app/backend/var

# node:alpine ships an unprivileged `node` user. Nothing here needs uid 0.
USER node

# The app's own default (env.ts resolvePort) is 3001; PORT overrides it. The
# healthcheck reads the same variable rather than assuming, so a deployment that
# moves the port does not silently fail its own health probe.
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD node -e "const p=process.env.PORT||3001;require('http').get('http://127.0.0.1:'+p+'/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

WORKDIR /app/backend

CMD ["node", "dist/main.js"]
